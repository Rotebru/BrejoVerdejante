using Godot;
using System;

public partial class Player : CharacterBody2D
{
	private AnimatedSprite2D _anim;
	
	//nodes da lingua
	private RayCast2D _tongueRay;
	private Line2D _tongueBody;
	private Sprite2D _tongueTip;
	
	public const float Speed = 80.0f;
	public const float JumpVelocity = -400.0f;
	
	//variaveis de movimento e alcance da lingua
	public const float TongueReach = 200.0f;
	public const float GrappleSpeed = 300.0f;
	private bool _isGrappling = false;
	private Vector2 _grapplePoint = Vector2.Zero;
	
	
	public override void _Ready(){
		_anim = GetNode<AnimatedSprite2D>("AnimatedSprite2D");
		_tongueRay = GetNode<RayCast2D>("TongueRay");
		_tongueBody = GetNode<Line2D>("TongueBody");
		_tongueTip = GetNode<Sprite2D>("TongueTip");
		
		// esconde a lingua no começo
		_tongueBody.Hide();
		_tongueTip.Hide();
	}
	
	public override void _PhysicsProcess(double delta){
		
		//permite modificar X e Y
		Vector2 velocity = Velocity;
		
		// se botão esqueedo do mouse for pressiondo, "atira" a lingua
		if (Input.IsActionJustPressed("shoot_tongue")){
			ShootTongue();
		}
		
		// logica de quando esta grudado na parede
		if (_isGrappling){
			
			Vector2 grappleDirection = (_grapplePoint - GlobalPosition).Normalized();
			velocity = grappleDirection * GrappleSpeed;
			
			// desenha o corpo da lingua
			_tongueBody.SetPointPosition(0, Vector2.Zero);
			_tongueBody.SetPointPosition(1, ToLocal(_grapplePoint));
			
			//animacao da boca deixei como comentario porque não tem sprite ainda
			//_anim.FlipH = grappleDirection.X < 0;
			
			//deixa os valores positivos
			float absX = Mathf.Abs(grappleDirection.X);
			float absY = Mathf.Abs(grappleDirection.Y);
			/* deixei como comentario porque não tem sprite ainda
			if (absX > 0.85f){
				_anim.Play("shoot_h");
			}
			else if (absY > 0.85f) {
				_anim.Play("shoot_v");
			}
			else {
				_anim.Play("shoot_d");
			}
			*/
			// ponta da lingua
			_tongueTip.Position = ToLocal(_grapplePoint);
			
			// solta lingua quando estiver perto de um alvo ou soltar o botao do mouse
			if (GlobalPosition.DistanceTo(_grapplePoint) < 15.0f || Input.IsActionJustReleased("shoot_tongue")){
				StopGrappling();
			}
		}
		
		// adiciona gravidade
		if (!IsOnFloor())
		{
			velocity += GetGravity() * (float)delta;
		}
		if (Input.IsActionJustPressed("jump") && IsOnFloor())
		{
			velocity.Y = JumpVelocity;
		}
		
		// pega a direção do input
		float direction = Input.GetAxis("left", "right");
		if (direction != 0){
			velocity.X = direction * Speed;
		}
		else{
			velocity.X = Mathf.MoveToward(velocity.X, 0, Speed);
		}
		
		// animações
		if (IsOnFloor())
		{
			if (direction > 0){
				_anim.FlipH = false;
				_anim.Play("walk");
			}
			else if (direction < 0){
				_anim.FlipH = true;
				_anim.Play("walk");
			}
			else{
				_anim.Play("idle");
			}
		}
		else{
			_anim.Play("jump");
		}
		
		Velocity = velocity;
		MoveAndSlide();
	}
	
	private void ShootTongue(){
		Vector2 mousePos = GetGlobalMousePosition();
		float angleToMouse = GetLocalMousePosition().Angle();
		
		//aponta o raio/tongueRay para o mouse
		_tongueRay.TargetPosition = ToLocal(mousePos).Normalized() * TongueReach;
		_tongueRay.ForceRaycastUpdate();
		
		//caso o raio bata em algo solido
		if (_tongueRay.IsColliding()){
			
			_grapplePoint = _tongueRay.GetCollisionPoint();
			_isGrappling = true;
			
			// faz o corpo da lingua aparecer
			_tongueBody.ClearPoints();
			_tongueBody.AddPoint(Vector2.Zero);
			_tongueBody.AddPoint(ToLocal(_grapplePoint));
			_tongueBody.Show();
			
			// faz a ponta da lingua aparecer e girar na direcaao certa
			_tongueTip.Position = ToLocal(_grapplePoint);
			_tongueTip.Rotation = angleToMouse;
			_tongueTip.Show();
		}
	}
	private void StopGrappling(){
			_isGrappling = false;
			_tongueBody.Hide();
			_tongueTip.Hide();
	}
}
